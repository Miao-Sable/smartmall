# ============ SmartMall 后端环境变量清单 ============
# 复制为 backend/.env（后端在 backend/ 目录启动时读取），
# 或在 systemd / 容器里 export 成环境变量。
# 所有变量均有默认值，但标注【必改】的项生产环境必须覆盖。

# ---- 安全【必改】----
# JWT 签名密钥：必须改成随机长字符串，否则任何人都能伪造登录态。
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# ---- 运行模式【生产必改】----
# false 时关闭 SQL 回显日志，生产务必 false
DEBUG=false

# ---- 数据库 ----
# 生产推荐 PostgreSQL；小规模试用也可用 SQLite 文件。
DATABASE_URL=postgresql://smartmall:yourpassword@127.0.0.1:5432/smartmall
# DATABASE_URL=sqlite:////opt/smartmall/smartmall.db

# ---- 跨域【必改】----
# 允许的前端来源，必须是 JSON 数组格式（多个来源逗号分隔）。
CORS_ORIGINS=["https://smartmall.example.com"]

# ---- 可选 ----
APP_NAME=智慧购物 API
ALGORITHM=HS256
# JWT 有效期（分钟），默认 7 天 = 10080
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# mock 数据目录；默认取项目根目录下的 mock/。部署时请把 mock/ 与后端一起上传，
# 或改成服务器上的绝对路径。
# MOCK_DIR=/opt/smartmall/mock
